# Optional. Leave unset for local dev — `npm run dev` proxies /monitor/api/v1 to the API on
# port 4000 (see vite.config.ts), so the default relative path already reaches it with no
# CORS involved, the same way production does. Only set this if the Portal and the API are
# reachable at genuinely different hosts (not just different localhost ports).
VITE_API_BASE_URL=

# Optional: label shown in the sidebar footer. Defaults to a generic notice when unset.
VITE_ORG_LABEL=
