# API port
PORT=4000

# Single shared login for the Portal. There is no signup and no default password — generate
# ADMIN_PASSWORD_HASH before the first run with: npm run hash-password -w apps/monitor-api -- "your-password"
# Without ADMIN_PASSWORD_HASH set, login never succeeds, by design.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# LibreChat's MongoDB — a dedicated READ-ONLY user (see README, "MongoDB read-only user")
# Without this variable, analytics endpoints return synthetic data (synthetic: true)
MONGO_URI=
MONGO_DB=LibreChat

# GCP project used to read platform logs (e.g. MCP proxy sidecars), if deployed on GCP
# Without this variable, /analytics/mcp-audit returns synthetic data
GOOGLE_CLOUD_PROJECT=

# Comma-separated Cloud Logging service names to read for the MCP audit trail (e.g. the
# names of your own MCP proxy services). Also requires GOOGLE_CLOUD_PROJECT above.
# Without this variable, /analytics/mcp-audit returns synthetic data
MCP_AUDIT_SERVICE_NAMES=

# Optional: name of a deployment-specific MongoDB collection that apportions token usage into
# a verified USD cost. This project doesn't require or produce one — without it, Costs
# computes an estimate from token counts times a placeholder price table (see pricing.ts)
# instead, using the same transactions data Usage already reads. Only set this if your
# deployment already has such a pipeline.
COST_COLLECTION_NAME=

# Policy catalog directory (YAML). In development this resolves on its own to ../../policies.
# Also holds mcp-integrations.yaml (which MCP tools exist and which roles may use them) —
# see that file's own header comment.
POLICIES_DIR=
