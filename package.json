{
  "name": "monitor-librechat",
  "version": "0.1.0",
  "description": "Adoption, cost, and security-shadow monitoring portal for a self-hosted LibreChat deployment.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UelingtonSilva/monitor-librechat.git"
  },
  "bugs": {
    "url": "https://github.com/UelingtonSilva/monitor-librechat/issues"
  },
  "homepage": "https://github.com/UelingtonSilva/monitor-librechat#readme",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w apps/monitor-api && npm run build -w apps/monitor-portal",
    "test": "npm run test -ws --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
